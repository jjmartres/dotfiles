    tip.innerHTML=`<b>${{new Date(p.t*1000).toLocaleString('fr-FR',{{weekday:'short',hour:'2-digit',minute:'2-digit'}})}}</b><br>`+series.filter(se=>p[se.k]!=null).map(se=>`${{se.n}} : <b>${{p[se.k].toLocaleString('fr-FR')}} ${{unit}}</b>`).join('<br>')+(band&&p[band]===1?'<br><span style="color:var(--muted)">sur secteur</span>':'');
    tip.dataset.t=p.t;tip.style.display='block';const px=xx*r.width/W;tip.style.left=Math.min(px+12,r.width-tip.offsetWidth)+'px';tip.style.top='8px'}});
