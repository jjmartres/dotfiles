#!/usr/bin/python3
"""sysstats — historique local CPU / RAM / disque / process / dossiers, rapports HTML.

  sysstats collect              échantillon (launchd, toutes les 5 min)
  sysstats du                   scan des plus gros dossiers (launchd, 1x/jour)
  sysstats daily                du + rapport du jour (launchd, 23:55)
  sysstats report [--date AAAA-MM-JJ | --hours N | --days N] [--no-open]
  sysstats status               état de la collecte et derniers runs
  sysstats install | uninstall  active / retire les tâches launchd (macOS)
"""
import argparse
import datetime as dt
import html
import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
BASE = os.path.join(HOME, ".local", "share", "sysstats")
DB = os.path.join(BASE, "stats.db")
REPORTS = os.path.join(BASE, "reports")
RETENTION_DAYS = 90
TREE_RETENTION_DAYS = 30  # détail par process (arbre), plus volumineux
TREE_MIN_CPU = 0.5        # % d'un cœur : en dessous, un process n'est gardé que comme parent
TREE_MIN_RSS = 50 << 20   # 50 Mo
TOP_N = 25
DU_MIN_KB = 200 * 1024  # on ne garde que les dossiers >= 200 Mo
DU_TARGETS = [(HOME, 3), ("/Applications", 1), ("/opt/homebrew", 2), ("/Library", 1)]
INTERPRETERS = {"python", "python3", "Python", "node", "ruby", "perl", "bash", "sh", "zsh", "fish", "bun", "deno", "java"}


def sh(args, timeout=60):
    try:
        env = dict(os.environ, LC_ALL="C", LANG="C")  # dates et nombres de ps/top en format fixe
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout, env=env).stdout
    except Exception:
        return ""


def db():
    os.makedirs(BASE, exist_ok=True)
    c = sqlite3.connect(DB, timeout=30)
    c.executescript("""
    CREATE TABLE IF NOT EXISTS samples(ts INTEGER PRIMARY KEY, load1 REAL, load5 REAL, load15 REAL,
      cpu_user REAL, cpu_sys REAL, ncpu INTEGER, mem_total INTEGER, mem_used INTEGER, mem_compressed INTEGER,
      mem_wired INTEGER, mem_free_pct INTEGER, swap_used INTEGER, swap_total INTEGER, disk_total INTEGER, disk_used INTEGER);
    CREATE TABLE IF NOT EXISTS procs(ts INTEGER, name TEXT, cpu REAL, rss INTEGER, n INTEGER);
    CREATE INDEX IF NOT EXISTS procs_ts ON procs(ts);
    CREATE TABLE IF NOT EXISTS dirs(day TEXT, path TEXT, kb INTEGER, PRIMARY KEY(day, path));
    CREATE TABLE IF NOT EXISTS runs(job TEXT PRIMARY KEY, ts INTEGER, ok INTEGER, detail TEXT);
    CREATE TABLE IF NOT EXISTS pinfo(pkey TEXT PRIMARY KEY, pid INTEGER, ppkey TEXT, ppid INTEGER, user TEXT,
      start INTEGER, exe TEXT, args TEXT, label TEXT, first INTEGER, last INTEGER);
    CREATE TABLE IF NOT EXISTS psamp(ts INTEGER, pkey TEXT, cpu REAL, pcpu REAL, rss INTEGER, th INTEGER, state TEXT);
    CREATE INDEX IF NOT EXISTS psamp_ts ON psamp(ts);
    CREATE TABLE IF NOT EXISTS cpu_last(pkey TEXT PRIMARY KEY, cputime REAL, ts INTEGER);
    CREATE TABLE IF NOT EXISTS sysextra(ts INTEGER PRIMARY KEY, nprocs INTEGER, nthreads INTEGER);
    CREATE TABLE IF NOT EXISTS power(ts INTEGER PRIMARY KEY, bat_pct INTEGER, charging INTEGER, plugged INTEGER,
      bat_temp REAL, bat_volt REAL, bat_amp REAL, bat_w REAL, cycles INTEGER, health REAL, raw_max INTEGER,
      design INTEGER, adapter_w INTEGER, cpu_temp REAL, gpu_temp REAL, fan_rpm INTEGER, fan_max INTEGER,
      sys_w REAL, cpu_w REAL, gpu_w REAL);
    """)
    return c


# ---------------------------------------------------------------- collecte

def proc_label(command):
    parts = command.split()
    exe = parts[0] if parts else command
    m = re.match(r"(.*?/([^/]+)\.app)/", command)
    base = os.path.basename(exe)
    if re.sub(r"[\d.]+$", "", base) in INTERPRETERS or base in INTERPRETERS:
        interp = re.sub(r"[\d.]+$", "", base).lower()
        if len(parts) > 2 and parts[1] in ("-c", "-m"):
            return f"{interp} {parts[1]} {os.path.basename(parts[2]) if parts[1] == '-m' else ''}".strip()[:60]
        for a in parts[1:]:
            if not a.startswith("-"):
                interp = re.sub(r"[\d.]+$", "", base).lower()
                return f"{interp}: {os.path.basename(a)}"[:60]
        return base
    if m and not m.group(2).startswith("Python"):
        return m.group(2)
    return base[:60] or "?"


def cpu_seconds(s):
    """Temps CPU de ps : [jj-][hh:]mm:ss.cc"""
    days = 0
    if "-" in s:
        d, s = s.split("-", 1)
        days = int(d)
    sec = 0.0
    for part in s.split(":"):
        sec = sec * 60 + float(part.replace(",", "."))
    return days * 86400 + sec


def snapshot_tree(c, ts):
    """Arbre complet des process. Le CPU vient du temps CPU consommé depuis l'échantillon précédent."""
    exe = {}
    for line in sh(["ps", "-Axo", "pid=,comm="]).splitlines():
        p = line.strip().split(None, 1)
        if len(p) == 2 and p[0].isdigit():
            exe[int(p[0])] = p[1]
    threads = {}
    for line in sh(["ps", "-AM"]).splitlines()[1:]:  # une ligne par thread ; USER vide sur les lignes suivantes
        tok = line.split()
        if not tok:
            continue
        pid = tok[0] if line[:1].isspace() else (tok[1] if len(tok) > 1 else "")
        if pid.isdigit():
            threads[int(pid)] = threads.get(int(pid), 0) + 1
    procs = {}
    for line in sh(["ps", "-Axww", "-o", "pid=,ppid=,user=,pcpu=,rss=,time=,state=,lstart=,args="]).splitlines():
        p = line.split(None, 12)
        if len(p) < 12 or not p[0].isdigit():
            continue
        try:
            pid, ppid = int(p[0]), int(p[1])
            start = int(time.mktime(time.strptime(" ".join(p[7:12]), "%a %b %d %H:%M:%S %Y")))
            procs[pid] = {"pid": pid, "ppid": ppid, "user": p[2], "pcpu": float(p[3].replace(",", ".")),
                          "rss": int(p[4]) * 1024, "cputime": cpu_seconds(p[5]), "state": p[6][:1],
                          "start": start, "args": (p[12] if len(p) > 12 else "")[:600]}
        except (ValueError, IndexError):
            continue
    for pr in procs.values():
        pr["pkey"] = f"{pr['pid']}:{pr['start']}"
    last = {k: (cpu, t) for k, cpu, t in c.execute("SELECT pkey, cputime, ts FROM cpu_last")}
    prev_ts = max((t for _, t in last.values()), default=None)
    for pr in procs.values():
        if pr["pkey"] in last:
            cpu0, t0 = last[pr["pkey"]]
            pr["cpu"] = max(0.0, (pr["cputime"] - cpu0) / max(1, ts - t0) * 100)
        elif prev_ts and pr["start"] >= prev_ts:  # né depuis le dernier échantillon
            pr["cpu"] = pr["cputime"] / max(1, ts - pr["start"]) * 100
        else:
            pr["cpu"] = pr["pcpu"]
    keep = set()
    for pid, pr in procs.items():
        if pr["cpu"] >= TREE_MIN_CPU or pr["pcpu"] >= 1 or pr["rss"] >= TREE_MIN_RSS:
            while pid in procs and pid not in keep:  # le process et toute sa chaîne de parents
                keep.add(pid)
                pid = procs[pid]["ppid"]
    rows_info, rows_samp = [], []
    for pid in keep:
        pr = procs[pid]
        parent = procs.get(pr["ppid"])
        args = pr["args"] or exe.get(pid, "")
        rows_info.append((pr["pkey"], pid, parent["pkey"] if parent else None, pr["ppid"], pr["user"], pr["start"],
                          exe.get(pid, args.split(" ")[0]), args, proc_label(args or exe.get(pid, "?")), ts, ts))
        rows_samp.append((ts, pr["pkey"], round(pr["cpu"], 2), pr["pcpu"], pr["rss"], threads.get(pid, 0), pr["state"]))
    c.executemany("""INSERT INTO pinfo VALUES(?,?,?,?,?,?,?,?,?,?,?) ON CONFLICT(pkey) DO UPDATE SET
                     ppkey=excluded.ppkey, ppid=excluded.ppid, last=excluded.last""", rows_info)
    c.executemany("INSERT INTO psamp VALUES(?,?,?,?,?,?,?)", rows_samp)
    c.execute("DELETE FROM cpu_last")
    c.executemany("INSERT INTO cpu_last VALUES(?,?,?)", [(pr["pkey"], pr["cputime"], ts) for pr in procs.values()])
    c.execute("INSERT OR REPLACE INTO sysextra VALUES(?,?,?)", (ts, len(procs), sum(threads.values())))
    cutoff = ts - TREE_RETENTION_DAYS * 86400
    c.execute("DELETE FROM psamp WHERE ts < ?", (cutoff,))
    c.execute("DELETE FROM pinfo WHERE last < ?", (cutoff,))
    c.execute("DELETE FROM sysextra WHERE ts < ?", (cutoff,))


def power_sample():
    """Batterie (ioreg, sans sudo) + températures / ventilateurs / puissance (macmon, si installé)."""
    r = {}
    bat = sh(["ioreg", "-rn", "AppleSmartBattery"], timeout=10)
    def iv(key):
        m = re.search(r'"%s" = (-?\d+)' % key, bat)
        if not m:
            return None
        v = int(m.group(1))
        return v - (1 << 64) if v >= 1 << 63 else v  # courant négatif affiché en non signé
    def yes(key):
        m = re.search(r'"%s" = (Yes|No)' % key, bat)
        return None if not m else int(m.group(1) == "Yes")
    if bat:
        volt, amp = iv("Voltage"), iv("Amperage")
        raw_max, design = iv("AppleRawMaxCapacity"), iv("DesignCapacity")
        t = iv("Temperature")
        m = re.search(r'"AdapterDetails" = \{[^}]*"Watts"=(\d+)', bat)
        r.update(bat_pct=iv("CurrentCapacity"), charging=yes("IsCharging"), plugged=yes("ExternalConnected"),
                 bat_temp=t / 100 if t is not None else None, bat_volt=volt / 1000 if volt else None,
                 bat_amp=amp / 1000 if amp is not None else None,
                 bat_w=round(volt * amp / 1e6, 2) if volt and amp is not None else None,
                 cycles=iv("CycleCount"), raw_max=raw_max, design=design,
                 health=round(raw_max / design * 100, 1) if raw_max and design else None,
                 adapter_w=int(m.group(1)) if m and yes("ExternalConnected") else None)
    macmon = shutil.which("macmon") or next((x for x in ("/opt/homebrew/bin/macmon", "/usr/local/bin/macmon") if os.path.exists(x)), None)
    if macmon:
        line = sh([macmon, "pipe", "-s", "1", "-i", "500"], timeout=15).strip().splitlines()
        try:
            d = json.loads(line[0]) if line else {}
        except ValueError:
            d = {}
        temp = d.get("temp") or {}
        fans = d.get("fans") or []
        r.update(cpu_temp=temp.get("cpu_temp_avg"), gpu_temp=temp.get("gpu_temp_avg"),
                 fan_rpm=max((f.get("rpm", 0) for f in fans), default=None),
                 fan_max=max((f.get("max_rpm", 0) for f in fans), default=None),
                 sys_w=d.get("sys_power"), cpu_w=d.get("cpu_power"), gpu_w=d.get("gpu_power"))
    return r


POWER_COLS = ["bat_pct", "charging", "plugged", "bat_temp", "bat_volt", "bat_amp", "bat_w", "cycles", "health",
              "raw_max", "design", "adapter_w", "cpu_temp", "gpu_temp", "fan_rpm", "fan_max", "sys_w", "cpu_w", "gpu_w"]


def collect():
    ts = int(time.time())
    load1, load5, load15 = os.getloadavg()
    cpu_user = cpu_sys = None
    for line in sh(["top", "-l", "2", "-n", "0", "-s", "1"]).splitlines():
        m = re.search(r"CPU usage: ([\d.]+)% user, ([\d.]+)% sys", line)
        if m:
            cpu_user, cpu_sys = float(m.group(1)), float(m.group(2))  # garde le 2e échantillon
    ncpu = os.cpu_count() or 1
    mem_total = int(sh(["sysctl", "-n", "hw.memsize"]).strip() or 0)
    vm = sh(["vm_stat"])
    page = int((re.search(r"page size of (\d+)", vm) or [0, 16384])[1])
    def pages(label):
        m = re.search(re.escape(label) + r":\s+(\d+)", vm)
        return int(m.group(1)) * page if m else 0
    wired = pages("Pages wired down")
    compressed = pages("Pages occupied by compressor")
    used = pages("Anonymous pages") - pages("Pages purgeable") + wired + compressed
    free_pct = int(sh(["sysctl", "-n", "kern.memorystatus_level"]).strip() or 0)
    sw = sh(["sysctl", "-n", "vm.swapusage"])
    def mb(k):
        m = re.search(k + r" = ([\d.]+)M", sw)
        return int(float(m.group(1)) * 1048576) if m else 0
    data_vol = "/System/Volumes/Data" if os.path.exists("/System/Volumes/Data") else "/"
    du = shutil.disk_usage(data_vol)

    agg = {}
    for line in sh(["ps", "-Axo", "pcpu=,rss=,command="]).splitlines():
        p = line.strip().split(None, 2)
        if len(p) < 3:
            continue
        try:
            cpu, rss = float(p[0].replace(",", ".")), int(p[1]) * 1024
        except ValueError:
            continue
        name = proc_label(p[2])
        a = agg.setdefault(name, [0.0, 0, 0])
        a[0] += cpu; a[1] += rss; a[2] += 1
    by_cpu = sorted(agg.items(), key=lambda kv: -kv[1][0])[:TOP_N]
    by_mem = sorted(agg.items(), key=lambda kv: -kv[1][1])[:TOP_N]
    keep = dict(by_cpu + by_mem)

    c = db()
    with c:
        c.execute("INSERT OR REPLACE INTO samples VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
                  (ts, load1, load5, load15, cpu_user, cpu_sys, ncpu, mem_total, used, compressed, wired,
                   free_pct, mb("used"), mb("total"), du.total, du.used))
        c.executemany("INSERT INTO procs VALUES(?,?,?,?,?)",
                      [(ts, k, round(v[0], 1), v[1], v[2]) for k, v in keep.items()])
        snapshot_tree(c, ts)
        pw = power_sample()
        if pw:
            c.execute("INSERT OR REPLACE INTO power VALUES(?%s)" % (",?" * len(POWER_COLS)),
                      [ts] + [pw.get(k) for k in POWER_COLS])
        cutoff = ts - RETENTION_DAYS * 86400
        c.execute("DELETE FROM samples WHERE ts < ?", (cutoff,))
        c.execute("DELETE FROM procs WHERE ts < ?", (cutoff,))
        c.execute("DELETE FROM dirs WHERE day < ?", (dt.date.fromtimestamp(cutoff).isoformat(),))
    c.close()


def du_scan():
    day = dt.date.today().isoformat()
    rows = {}
    for target, depth in DU_TARGETS:
        if not os.path.isdir(target):
            continue
        out = sh(["nice", "-n", "19", "du", "-xk", "-d", str(depth), target], timeout=1800)
        for line in out.splitlines():
            p = line.split("\t", 1)
            if len(p) == 2 and p[0].isdigit() and int(p[0]) >= DU_MIN_KB:
                rows[p[1]] = int(p[0])
    if rows:
        c = db()
        with c:
            c.execute("DELETE FROM dirs WHERE day=?", (day,))
            c.executemany("INSERT INTO dirs VALUES(?,?,?)", [(day, k, v) for k, v in rows.items()])
        c.close()


# ---------------------------------------------------------------- rapport

def gb(b):
    return b / 1073741824


def fmt_size(kb):
    b = kb * 1024
    for unit, f in (("To", 1 << 40), ("Go", 1 << 30), ("Mo", 1 << 20)):
        if b >= f:
            return f"{b / f:.1f} {unit}".replace(".", ",")
    return f"{kb} Ko"


def short_path(p):
    return "~" + p[len(HOME):] if p.startswith(HOME) else p


def build_report(start, end, title, out_path):
    c = db()
    S = c.execute("SELECT ts,load1,cpu_user,cpu_sys,ncpu,mem_total,mem_used,swap_used,disk_total,disk_used,mem_free_pct "
                  "FROM samples WHERE ts>=? AND ts<? ORDER BY ts", (start, end)).fetchall()
    if not S:
        c.close()
        return None
    n = len(S)
    ncpu = S[-1][4] or 1
    # séries (sous-échantillonnées à ~600 points)
    step = max(1, n // 600)
    def bucket(i):
        chunk = S[i:i + step]
        return chunk
    pts = []
    for i in range(0, n, step):
        ch = S[i:i + step]
        cpu = [(r[2] or 0) + (r[3] or 0) for r in ch]
        pts.append({"t": ch[0][0], "cpu": round(sum(cpu) / len(ch), 1), "load": round(max(r[1] for r in ch), 2),
                    "mem": round(gb(sum(r[6] for r in ch) / len(ch)), 2), "swap": round(gb(max(r[7] for r in ch)), 2)})
    # énergie et températures, alignées sur les mêmes points
    PW = {r[0]: dict(zip(POWER_COLS, r[1:])) for r in c.execute(
        "SELECT ts,%s FROM power WHERE ts>=? AND ts<?" % ",".join(POWER_COLS), (start, end))}
    def pmean(chunk, k, agg="avg", nd=1):
        v = [PW[r[0]][k] for r in chunk if r[0] in PW and PW[r[0]][k] is not None]
        if not v:
            return None
        return round(max(v) if agg == "max" else sum(v) / len(v), nd)
    for i, pt in enumerate(pts):
        ch = S[i * step:i * step + step]
        pt.update(bat=pmean(ch, "bat_pct", nd=0), plug=pmean(ch, "plugged", "max", 0),
                  ctemp=pmean(ch, "cpu_temp"), gtemp=pmean(ch, "gpu_temp"), btemp=pmean(ch, "bat_temp"),
                  fan=pmean(ch, "fan_rpm", "max", 0), sysw=pmean(ch, "sys_w"), cpuw=pmean(ch, "cpu_w"),
                  gpuw=pmean(ch, "gpu_w"), batw=pmean(ch, "bat_w"))
    power = None
    if PW:
        rows = [PW[k] for k in sorted(PW)]
        def col(k):
            return [r[k] for r in rows if r[k] is not None]
        def avg(v):
            return sum(v) / len(v) if v else None
        last = rows[-1]
        power = {"bat_last": last["bat_pct"], "bat_min": min(col("bat_pct"), default=None), "bat_max": max(col("bat_pct"), default=None),
                 "plugged_pct": avg([r["plugged"] for r in rows if r["plugged"] is not None]),
                 "health": last["health"], "cycles": last["cycles"], "raw_max": last["raw_max"], "design": last["design"],
                 "bat_temp_max": max(col("bat_temp"), default=None),
                 "cpu_temp_avg": avg(col("cpu_temp")), "cpu_temp_max": max(col("cpu_temp"), default=None),
                 "gpu_temp_max": max(col("gpu_temp"), default=None),
                 "fan_max": max(col("fan_rpm"), default=None), "fan_limit": max(col("fan_max"), default=None),
                 "sys_w_avg": avg(col("sys_w")), "sys_w_max": max(col("sys_w"), default=None),
                 "cpu_w_avg": avg(col("cpu_w")), "gpu_w_avg": avg(col("gpu_w")),
                 "has_bat": bool(col("bat_pct")), "has_temp": bool(col("cpu_temp")), "has_fan": bool(col("fan_rpm"))}
    cpu_all = [(r[2] or 0) + (r[3] or 0) for r in S]
    mem_total = S[-1][5]
    tiles = {
        "cpu_avg": sum(cpu_all) / n, "cpu_max": max(cpu_all),
        "load_avg": sum(r[1] for r in S) / n, "load_max": max(r[1] for r in S), "ncpu": ncpu,
        "mem_avg": gb(sum(r[6] for r in S) / n), "mem_max": gb(max(r[6] for r in S)), "mem_total": gb(mem_total),
        "swap_max": gb(max(r[7] for r in S)), "pressure_min": min(r[10] for r in S),
        "disk_used": gb(S[-1][9]), "disk_total": gb(S[-1][8]), "disk_delta": gb(S[-1][9] - S[0][9]),
        "samples": n,
    }
    # process
    P = c.execute("SELECT name, SUM(cpu), MAX(cpu), SUM(rss), MAX(rss), COUNT(*) FROM procs WHERE ts>=? AND ts<? GROUP BY name",
                  (start, end)).fetchall()
    top_cpu = sorted(P, key=lambda r: -r[1])[:15]
    top_mem = sorted(P, key=lambda r: -r[3])[:15]
    # moments les plus chargés
    peaks = sorted(S, key=lambda r: -r[1])
    chosen = []
    for r in peaks:
        if all(abs(r[0] - x[0]) > 1800 for x in chosen):
            chosen.append(r)
        if len(chosen) == 8:
            break
    peak_rows = []
    for r in sorted(chosen, key=lambda r: r[0]):
        procs = c.execute("SELECT name, cpu FROM procs WHERE ts=? ORDER BY cpu DESC LIMIT 4", (r[0],)).fetchall()
        peak_rows.append((r[0], r[1], (r[2] or 0) + (r[3] or 0), procs))
    # dossiers
    day = c.execute("SELECT MAX(day) FROM dirs WHERE day<=?", (dt.date.fromtimestamp(end - 1).isoformat(),)).fetchone()[0]
    dirs, prev_day = [], None
    if day:
        prev_day = c.execute("SELECT MAX(day) FROM dirs WHERE day<?", (day,)).fetchone()[0]
        cur = dict(c.execute("SELECT path, kb FROM dirs WHERE day=?", (day,)).fetchall())
        prev = dict(c.execute("SELECT path, kb FROM dirs WHERE day=?", (prev_day,)).fetchall()) if prev_day else {}
        roots = {t for t, _ in DU_TARGETS}
        # retire un parent quand un enfant en représente >= 80 %
        def redundant(p, kb):
            pre = p.rstrip("/") + "/"
            return any(q.startswith(pre) and k >= 0.8 * kb for q, k in cur.items())
        cand = [(p, kb) for p, kb in cur.items() if p not in roots and not redundant(p, kb)]
        for p, kb in sorted(cand, key=lambda x: -x[1])[:30]:
            dirs.append((p, kb, (kb - prev[p]) if p in prev else None))
    c.close()

    data = {"points": pts, "range_days": (end - start) / 86400}
    explorer = explorer_data(start, end, S, ncpu, mem_total)
    html_text = render_html(title, start, end, tiles, top_cpu, top_mem, peak_rows, dirs, day, prev_day, data, explorer, power)
    os.makedirs(os.path.dirname(out_path), exist_ok=True)
    with open(out_path, "w") as f:
        f.write(html_text)
    # nettoyage des vieux rapports
    cutoff = time.time() - RETENTION_DAYS * 86400
    for fn in os.listdir(REPORTS):
        fp = os.path.join(REPORTS, fn)
        if os.path.isfile(fp) and os.path.getmtime(fp) < cutoff:
            os.remove(fp)
    return out_path


def explorer_data(start, end, S, ncpu, mem_total):
    """Arbre des process pour l'explorateur : agrégats sur la période + instantanés."""
    c = db()
    ts_list = [r[0] for r in S]
    dts, prev = {}, None
    for t in ts_list:
        dts[t] = min(900, t - prev) if prev else 300
        prev = t
    agg, by_ts = {}, {}
    for t, k, cpu, rss, th, st in c.execute(
            "SELECT ts, pkey, cpu, rss, th, state FROM psamp WHERE ts>=? AND ts<?", (start, end)):
        a = agg.get(k)
        if a is None:
            a = agg[k] = [0.0, 0.0, 0, 0, 0, t, t, 0]
        a[0] += cpu / 100 * dts.get(t, 300)
        a[1] = max(a[1], cpu); a[2] += rss; a[3] = max(a[3], rss); a[4] = max(a[4], th)
        a[5] = min(a[5], t); a[6] = max(a[6], t); a[7] += 1
        by_ts.setdefault(t, []).append((k, cpu, rss, th, st))
    if not agg:
        c.close()
        return None
    info = {}
    todo = set(agg)
    while todo:  # pinfo des process + parents manquants
        ks = list(todo)
        todo = set()
        for i in range(0, len(ks), 500):
            chunk = ks[i:i + 500]
            q = "SELECT pkey,pid,ppkey,user,start,exe,args,label FROM pinfo WHERE pkey IN (%s)" % ",".join("?" * len(chunk))
            for r in c.execute(q, chunk):
                info[r[0]] = r
                if r[2] and r[2] not in info and r[2] not in agg:
                    todo.add(r[2])
        todo -= set(info)
    extra = dict((t, (n, th)) for t, n, th in c.execute("SELECT ts, nprocs, nthreads FROM sysextra WHERE ts>=? AND ts<?", (start, end)))
    c.close()
    keys = list(info)
    idx = {k: i for i, k in enumerate(keys)}
    procs = []
    for k in keys:
        _, pid, ppkey, user, st, exe, args, label = info[k]
        procs.append([pid, idx.get(ppkey, -1), user, st, os.path.basename(exe or "")[:80], args or "", label])
    aggs = []
    for k in keys:
        a = agg.get(k)
        aggs.append([round(a[0], 1), round(a[1], 1), round(a[2] / a[7] / 1048576), round(a[3] / 1048576), a[4], a[5], a[6], a[7]]
                    if a else None)
    # instantanés : tous si raisonnable, sinon un échantillonnage régulier + les pics de charge
    snap_ts = [t for t in ts_list if t in by_ts]
    if len(snap_ts) > 600:
        stride = len(snap_ts) / 480
        chosen = {snap_ts[int(i * stride)] for i in range(480)}
        load = {r[0]: r[1] for r in S}
        chosen |= set(sorted(snap_ts, key=lambda t: -load[t])[:120])
        snap_ts = sorted(chosen)
    srow = {r[0]: r for r in S}
    snaps = []
    for t in snap_ts:
        r = srow[t]
        n, th = extra.get(t, (0, 0))
        snaps.append({"t": t, "cpu": round((r[2] or 0) + (r[3] or 0), 1), "load": round(r[1], 2),
                      "mem": round(r[6] / 1048576), "swap": round(r[7] / 1048576), "np": n, "nt": th,
                      "rows": [[idx[k], round(cpu, 1), round(rss / 1048576), thr, st] for k, cpu, rss, thr, st in by_ts[t] if k in idx]})
    peak = max(range(len(snaps)), key=lambda i: snaps[i]["load"]) if snaps else 0
    return {"procs": procs, "agg": aggs, "snaps": snaps, "peak": peak, "ncpu": ncpu,
            "memTotal": round(mem_total / 1048576), "period": end - start}


def nf(x, d=1):
    return f"{x:.{d}f}".replace(".", ",")



# ---------------------------------------------------------------- explorateur de process (style htop/btop)

