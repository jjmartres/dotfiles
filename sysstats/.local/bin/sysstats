EXPLORER_JS = r'''
(()=>{
if(typeof EX==='undefined'||!EX)return;
const P=EX.procs,A=EX.agg,S=EX.snaps,NC=EX.ncpu,MT=EX.memTotal;
const root=document.getElementById('px');
const st={mode:'period',view:'tree',sort:{period:'cpusec',snap:'cpu'},asc:false,q:'',all:false,snap:EX.peak,sel:-1,col:new Set(),exp:new Set()};
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const fr=(v,d=1)=>(+v).toLocaleString('fr-FR',{minimumFractionDigits:d,maximumFractionDigits:d});
const mb=v=>v>=1024?fr(v/1024,1)+' Go':Math.round(v)+' Mo';
const secs=s=>s>=3600?Math.floor(s/3600)+' h '+String(Math.floor(s%3600/60)).padStart(2,'0'):s>=60?Math.floor(s/60)+' min '+String(Math.floor(s%60)).padStart(2,'0'):fr(s,s<10?1:0)+' s';
const hm=t=>new Date(t*1000).toLocaleTimeString('fr-FR',{hour:'2-digit',minute:'2-digit'});
const day=t=>new Date(t*1000).toLocaleString('fr-FR',{weekday:'short',day:'2-digit',month:'2-digit',hour:'2-digit',minute:'2-digit'});
const meter=v=>`<span class="mt"><i class="${v>100?'hot':''}" style="width:${Math.min(100,v)}%"></i></span>`;

const COLS={
 period:[
  {k:'name',h:'Process'},{k:'pid',h:'PID',n:1},{k:'user',h:'Util.'},
  {k:'cpusec',h:'Temps CPU',n:1,sub:1},{k:'cpu',h:'CPU moy.',n:1},{k:'peak',h:'CPU pic',n:1},
  {k:'rss',h:'RAM moy.',n:1,sub:1},{k:'rsspeak',h:'RAM pic',n:1},{k:'th',h:'Thr.',n:1},{k:'life',h:'Vu'},{k:'cmd',h:'Commande'}],
 snap:[
  {k:'name',h:'Process'},{k:'pid',h:'PID',n:1},{k:'user',h:'Util.'},{k:'state',h:'S'},
  {k:'cpu',h:'CPU %',n:1,sub:1},{k:'mem',h:'MEM %',n:1},{k:'rss',h:'RSS',n:1,sub:1},{k:'th',h:'Thr.',n:1},
  {k:'start',h:'Démarré',n:1},{k:'cmd',h:'Commande'}]};

function metrics(){
  const m=new Map();
  if(st.mode==='period'){
    A.forEach((a,i)=>{if(!a)return;const alive=Math.max(300,a[6]-a[5]+300);
      m.set(i,{cpusec:a[0],cpu:a[0]/alive*100,peak:a[1],rss:a[2],rsspeak:a[3],th:a[4],first:a[5],last:a[6]})});
  }else{
    const s=S[st.snap];if(s)for(const r of s.rows)m.set(r[0],{cpu:r[1],rss:r[2],th:r[3],state:r[4],mem:r[2]/MT*100});
  }
  // les parents absents de la période restent comme nœuds de structure
  for(const i of [...m.keys()]){let p=P[i][1];while(p>=0&&!m.has(p)){m.set(p,{cpusec:0,cpu:0,peak:0,rss:0,rsspeak:0,th:0,mem:0,state:'',ghost:1});p=P[p][1]}}
  return m;
}
function tree(m){
  const kids=new Map(),roots=[];
  for(const i of m.keys()){
    let p=P[i][1];
    if(p<0||P[i][0]<=1||P[p][0]===0){roots.push(i);continue}
    if(P[p][0]===1&&P[i][0]!==1){roots.push(i);continue}// enfants de launchd au premier niveau
    (kids.get(p)||kids.set(p,[]).get(p)).push(i);
  }
  const sub=new Map();
  const walk=i=>{const o=m.get(i);const s={cpusec:o.cpusec||0,cpu:o.cpu||0,rss:o.rss||0,n:1};
    for(const c of kids.get(i)||[]){const t=walk(c);s.cpusec+=t.cpusec;s.cpu+=t.cpu;s.rss+=t.rss;s.n+=t.n}
    sub.set(i,s);return s};
  roots.forEach(walk);
  return {kids,roots,sub};
}
function val(i,k,m,sub,useSub){
  const o=m.get(i),p=P[i];
  switch(k){
    case 'name':return p[6].toLowerCase();case 'pid':return p[0];case 'user':return p[2];case 'cmd':return p[5];
    case 'start':return p[3];case 'life':return o.first||0;case 'state':return o.state||'';
    default:return useSub&&sub&&sub.has(i)&&(k in sub.get(i))?sub.get(i)[k]:(o[k]||0);
  }
}
function render(){
  const m=metrics(),T=tree(m),cols=COLS[st.mode],sk=st.sort[st.mode],q=st.q.trim().toLowerCase();
  const isTree=st.view==='tree';
  const cmp=(a,b)=>{const x=val(a,sk,m,T.sub,isTree),y=val(b,sk,m,T.sub,isTree);const r=x<y?-1:x>y?1:0;return st.asc?r:-r};
  const match=i=>{const p=P[i];return p[6].toLowerCase().includes(q)||p[5].toLowerCase().includes(q)||String(p[0])===q||p[2].toLowerCase()===q};
  let visible;
  const totalSec=[...m.values()].reduce((s,o)=>s+(o.cpusec||0),0);
  const significant=i=>{const s=T.sub.get(i);if(!s)return false;
    return st.mode==='period'?(s.cpusec>=Math.max(2,totalSec*0.001)||s.rss>=150):(s.cpu>=0.5||s.rss>=100)};
  if(q){visible=new Set();for(const i of m.keys())if(match(i)){let j=i;while(j>=0&&!visible.has(j)){visible.add(j);j=P[j][1]}}}
  else if(!st.all){visible=new Set([...m.keys()].filter(significant))}
  else visible=new Set(m.keys());
  const rows=[];
  if(isTree){
    const vk=i=>(T.kids.get(i)||[]).filter(c=>visible.has(c));
    const collapsed=(i,n)=>!q&&(st.col.has(i)||(n>12&&!st.exp.has(i)));
    const emit=(i,d,guide)=>{const ks=vk(i).sort(cmp);rows.push([i,d,ks.length,collapsed(i,ks.length),guide]);
      if(!collapsed(i,ks.length))ks.forEach((c,j)=>emit(c,d+1,guide+(j===ks.length-1?'└ ':'├ ')));};
    T.roots.filter(i=>visible.has(i)).sort(cmp).forEach(i=>emit(i,0,''));
  }else{
    [...visible].filter(i=>!m.get(i).ghost&&(q?match(i):true)).sort(cmp).forEach(i=>rows.push([i,0,0,false,'']));
  }
  const LIMIT=1500,shown=rows.slice(0,LIMIT);
  let h='<table class="pt"><thead><tr>'+cols.map(c=>`<th data-sort="${c.k}" class="${c.n?'num ':''}${c.k===sk?'on'+(st.asc?' asc':''):''}">${c.h}</th>`).join('')+'</tr></thead><tbody>';
  for(const [i,d,nk,col,guide] of shown){
    const o=m.get(i),p=P[i],s=T.sub.get(i);
    const caret=isTree&&nk?`<span class="cr" data-tog="${i}">${col?'▸':'▾'}</span>`:'<span class="cr"></span>';
    const g=isTree?`<span class="guide">${guide.slice(0,-2).replace(/├ /g,'│ ').replace(/└ /g,'  ')}${guide.slice(-2)}</span>`:'';
    const kidsNote=isTree&&nk&&col?`<span class="sum">+${s.n-1}</span>`:'';
    const cells=cols.map(c=>{
      const showSum=isTree&&c.sub&&nk&&s;
      switch(c.k){
        case 'name':return `<td class="nm" title="${esc(p[5])}">${g}${caret}<b>${esc(p[6])}</b>${kidsNote}</td>`;
        case 'pid':return `<td class="num">${p[0]}</td>`;
        case 'user':return `<td>${esc(p[2].slice(0,10))}</td>`;
        case 'cmd':return `<td class="cmd" title="${esc(p[5])}">${esc(p[5].slice(0,160))}</td>`;
        case 'cpusec':return `<td class="num">${o.ghost?'':secs(o.cpusec)}${showSum&&s.cpusec>o.cpusec+0.5?`<span class="sum">Σ ${secs(s.cpusec)}</span>`:''}</td>`;
        case 'cpu':return `<td class="num">${o.ghost?'':meter(o.cpu)+fr(o.cpu)}${st.mode==='snap'&&showSum&&s.cpu>o.cpu+0.5?`<span class="sum">Σ ${fr(s.cpu)}</span>`:''}</td>`;
        case 'peak':return `<td class="num">${o.ghost?'':fr(o.peak,0)+' %'}</td>`;
        case 'rss':return `<td class="num">${o.ghost?'':mb(o.rss)}${showSum&&s.rss>o.rss+1?`<span class="sum">Σ ${mb(s.rss)}</span>`:''}</td>`;
        case 'rsspeak':return `<td class="num">${o.ghost?'':mb(o.rsspeak)}</td>`;
        case 'mem':return `<td class="num">${o.ghost?'':fr(o.mem)}</td>`;
        case 'th':return `<td class="num">${o.th||''}</td>`;
        case 'state':return `<td class="st-${o.state}">${o.state||''}</td>`;
        case 'start':return `<td class="num">${day(p[3])}</td>`;
        case 'life':return `<td>${o.first?hm(o.first)+' → '+hm(o.last):''}</td>`;
      }}).join('');
    h+=`<tr class="r${st.sel===i?' sel':''}" data-row="${i}">${cells}</tr>`;
    if(st.sel===i)h+=`<tr class="det"><td colspan="${cols.length}">${detail(i,m,T)}</td></tr>`;
  }
  h+='</tbody></table>';
  if(rows.length>LIMIT)h+=`<p class="sub">… ${rows.length-LIMIT} lignes de plus : affine la recherche.</p>`;
  root.querySelector('.px-wrap').innerHTML=h;const wrap=root.querySelector('.px-wrap');wrap.querySelectorAll('tr.det td>.det').forEach(d=>d.style.width=(wrap.clientWidth-28)+'px');
  root.querySelector('.px-count').textContent=`${rows.length} process affichés sur ${m.size}`+(st.all||q?'':' (les plus significatifs)');
  renderSnapHeader();
}
function spark(vals,fmt){
  if(!vals.some(v=>v>0))return '<span class="dim">—</span>';
  const W=300,H=46,mx=Math.max(...vals)||1,n=vals.length;
  const pts=vals.map((v,j)=>`${(j/(Math.max(1,n-1))*W).toFixed(1)},${(H-3-(v/mx)*(H-6)).toFixed(1)}`).join(' ');
  return `<svg class="spark" viewBox="0 0 ${W} ${H}" preserveAspectRatio="none"><polygon points="0,${H} ${pts} ${W},${H}" fill="var(--s1)" opacity=".15"/><polyline points="${pts}" fill="none" stroke="var(--s1)" stroke-width="1.6" vector-effect="non-scaling-stroke"/></svg><span class="dim" style="font-size:11px">max ${fmt(mx)}</span>`;
}
function detail(i,m,T){
  const p=P[i],o=m.get(i),s=T.sub.get(i);
  const chain=[];let j=p[1];while(j>=0&&chain.length<12){chain.unshift(j);j=P[j][1]}
  const chainH=chain.map(k=>`<a data-sel="${k}">${esc(P[k][6])} <span class="dim">${P[k][0]}</span></a>`).join(' → ')+(chain.length?' → ':'')+`<b>${esc(p[6])}</b>`;
  const kids=(T.kids.get(i)||[]);
  const kidsH=kids.slice().sort((a,b)=>(T.sub.get(b).cpusec+T.sub.get(b).cpu)-(T.sub.get(a).cpusec+T.sub.get(a).cpu)).slice(0,12)
    .map(k=>`<a data-sel="${k}">${esc(P[k][6])} <span class="dim">${P[k][0]}</span></a>`).join(', ')+(kids.length>12?` … +${kids.length-12}`:'');
  const cpuS=[],rssS=[];
  for(const sn of S){const r=sn.rows.find(r=>r[0]===i);cpuS.push(r?r[1]:0);rssS.push(r?r[2]:0)}
  const a=A[i];
  return `<div class="det"><div class="k">Commande complète</div><code>${esc(p[5]||p[4])}</code>
  <div class="det-grid">
   <div><div class="k">Chaîne des parents</div>${chainH}</div>
   <div><div class="k">Enfants (${kids.length})</div>${kidsH||'<span class="dim">aucun</span>'}</div>
   <div><div class="k">Identité</div>PID ${p[0]} · ${esc(p[2])} · exécutable <b>${esc(p[4])}</b><br>démarré ${day(p[3])}</div>
   <div><div class="k">Sur la période</div>${a?`temps CPU ${secs(a[0])} (Σ sous-arbre ${secs(s&&st.mode==='period'?s.cpusec:a[0])}) · pic ${fr(a[1],0)} % · RAM moy. ${mb(a[2])}, pic ${mb(a[3])} · vu de ${hm(a[5])} à ${hm(a[6])}`:'<span class="dim">pas de mesure propre (process parent)</span>'}</div>
   <div><div class="k">CPU (% d'un cœur) au fil des instantanés</div>${spark(cpuS,v=>fr(v,0)+' %')}</div>
   <div><div class="k">RAM au fil des instantanés</div>${spark(rssS,mb)}</div>
  </div></div>`;
}
function renderSnapHeader(){
  const box=root.querySelector('.px-snap');
  if(st.mode!=='snap'||!S.length){box.style.display='none';return}
  box.style.display='grid';
  const s=S[st.snap];
  box.querySelector('.px-when').textContent=day(s.t);
  box.querySelector('input').value=st.snap;
  const bar=(label,v,max,txt)=>`<div class="mm"><b>${label}</b><span class="track"><i style="width:${Math.min(100,v/max*100)}%;${v>max?'background:var(--s2)':''}"></i></span><span>${txt}</span></div>`;
  box.querySelector('.px-meters').innerHTML=
    bar('CPU',s.cpu,100,fr(s.cpu,0)+' %')+bar('Load',s.load,NC,fr(s.load)+' / '+NC)+
    bar('Mém',s.mem,MT,mb(s.mem)+' / '+mb(MT))+bar('Swap',s.swap,Math.max(s.swap,1024),mb(s.swap))+
    `<div class="mm"><b>Tâches</b><span>${s.np||'?'} process, ${s.nt||'?'} threads</span></div>`;
}
root.innerHTML=`<div class="px-bar">
 <span class="seg"><button data-mode="period">Période</button><button data-mode="snap">Instantané</button></span>
 <span class="seg"><button data-view="tree">Arbre</button><button data-view="list">Liste</button></span>
 <input type="search" placeholder="Filtrer : nom, commande, PID, utilisateur…">
 <label><input type="checkbox" class="px-all"> tout afficher</label><span class="px-count"></span></div>
 <div class="px-snap"><button data-step="-1">◀</button><input type="range" min="0" max="${Math.max(0,S.length-1)}"><button data-step="1">▶</button>
 <span class="px-when"></span><span></span><button data-peak="1">Pic de charge</button><div class="px-meters"></div></div>
 <div class="px-wrap"></div>`;
const syncBtns=()=>{root.querySelectorAll('[data-mode]').forEach(b=>b.classList.toggle('on',b.dataset.mode===st.mode));
  root.querySelectorAll('[data-view]').forEach(b=>b.classList.toggle('on',b.dataset.view===st.view))};
root.addEventListener('click',e=>{
  const t=e.target.closest('[data-mode],[data-view],[data-sort],[data-tog],[data-sel],[data-step],[data-peak],[data-row]');if(!t)return;
  const d=t.dataset;
  if(d.mode){st.mode=d.mode;st.sel=-1}
  else if(d.view)st.view=d.view;
  else if(d.sort){if(st.sort[st.mode]===d.sort)st.asc=!st.asc;else{st.sort[st.mode]=d.sort;st.asc=['name','user','cmd','state'].includes(d.sort)}}
  else if(d.tog!==undefined){e.stopPropagation();const i=+d.tog,n=st.col.has(i)||!st.exp.has(i);
    const isCol=t.textContent==='▸';if(isCol){st.col.delete(i);st.exp.add(i)}else{st.col.add(i);st.exp.delete(i)}}
  else if(d.sel!==undefined){st.sel=+d.sel;let j=P[st.sel][1];while(j>=0){st.col.delete(j);st.exp.add(j);j=P[j][1]}}
  else if(d.step){st.snap=Math.max(0,Math.min(S.length-1,st.snap+ +d.step))}
  else if(d.peak){st.snap=EX.peak}
  else if(d.row!==undefined){const i=+d.row;st.sel=st.sel===i?-1:i}
  syncBtns();render();
});
root.querySelector('input[type=search]').addEventListener('input',e=>{st.q=e.target.value;render()});
root.querySelector('.px-all').addEventListener('change',e=>{st.all=e.target.checked;render()});
root.querySelector('input[type=range]').addEventListener('input',e=>{st.snap=+e.target.value;render()});
window.pickTime=t=>{if(!S.length)return;let b=0,bd=1e18;S.forEach((s,j)=>{const d=Math.abs(s.t-t);if(d<bd){bd=d;b=j}});
  st.mode='snap';st.snap=b;st.sel=-1;syncBtns();render();document.getElementById('px-card').scrollIntoView({behavior:'smooth'})};
syncBtns();render();
})();
'''


def power_html(pw):
    if not pw:
        return ""
    def v(x, d=0, unit=""):
        return "—" if x is None else f"{nf(x, d)}{unit}"
    tiles = []
    if pw["has_bat"]:
        tiles.append(f'<div class="card tile"><div class="k">Batterie</div><div class="v">{v(pw["bat_last"], 0, " %")}</div>'
                     f'<div class="d">min {v(pw["bat_min"], 0, " %")} · sur secteur {v((pw["plugged_pct"] or 0) * 100, 0, " %")} du temps</div></div>')
        tiles.append(f'<div class="card tile"><div class="k">Santé batterie</div><div class="v">{v(pw["health"], 0, " %")}</div>'
                     f'<div class="d">{v(pw["cycles"])} cycles · {v(pw["raw_max"])} / {v(pw["design"])} mAh</div></div>')
    if pw["has_temp"]:
        tiles.append(f'<div class="card tile"><div class="k">Température CPU</div><div class="v">{v(pw["cpu_temp_avg"], 0, " °C")}</div>'
                     f'<div class="d">pic {v(pw["cpu_temp_max"], 0, " °C")} · GPU pic {v(pw["gpu_temp_max"], 0, " °C")}</div></div>')
    if pw["bat_temp_max"] is not None:
        tiles.append(f'<div class="card tile"><div class="k">Température batterie max</div><div class="v">{v(pw["bat_temp_max"], 1, " °C")}</div>'
                     f'<div class="d">au-delà de 35 °C, la batterie s\'use plus vite</div></div>')
    if pw["sys_w_avg"] is not None:
        tiles.append(f'<div class="card tile"><div class="k">Consommation moy.</div><div class="v">{v(pw["sys_w_avg"], 1, " W")}</div>'
                     f'<div class="d">pic {v(pw["sys_w_max"], 0, " W")} · CPU {v(pw["cpu_w_avg"], 1, " W")} · GPU {v(pw["gpu_w_avg"], 1, " W")}</div></div>')
    if pw["has_fan"]:
        tiles.append(f'<div class="card tile"><div class="k">Ventilateurs max</div><div class="v">{v(pw["fan_max"])} tr/min</div>'
                     f'<div class="d">limite {v(pw["fan_limit"])} tr/min</div></div>')
    leg = lambda items: '<div class="legend">' + "".join(f'<span><i style="background:var({c})"></i>{n}</span>' for c, n in items) + "</div>"
    charts = []
    if pw["has_bat"]:
        charts.append('<div class="card"><h2>Batterie (%)</h2>' + leg([("--s1", "Charge"), ("--band", "Sur secteur")]) + '<div class="chart" id="c-bat"></div></div>')
    if pw["has_temp"] or pw["bat_temp_max"] is not None:
        items = ([("--s1", "CPU"), ("--s2", "GPU")] if pw["has_temp"] else []) + ([("--s3", "Batterie")] if pw["bat_temp_max"] is not None else [])
        charts.append('<div class="card"><h2>Températures (°C)</h2>' + leg(items) + '<div class="chart" id="c-temp"></div></div>')
    if pw["sys_w_avg"] is not None:
        charts.append('<div class="card"><h2>Puissance (W)</h2>' + leg([("--s1", "Système"), ("--s2", "CPU"), ("--s3", "GPU")]) + '<div class="chart" id="c-pow"></div></div>')
    if pw["has_fan"]:
        charts.append('<div class="card"><h2>Ventilateurs (tr/min, le plus rapide)</h2><div class="chart" id="c-fan"></div></div>')
    return ('<section id="power"><h2 style="font-size:17px;margin:24px 0 12px">Énergie et températures</h2>'
            f'<div class="tiles">{"".join(tiles)}</div><div class="grid2">{"".join(charts)}</div></section>')


def render_html(title, start, end, t, top_cpu, top_mem, peaks, dirs, day, prev_day, data, explorer=None, power=None):
    e = html.escape
    def when(ts, fmt="%d/%m %H:%M"):
        return dt.datetime.fromtimestamp(ts).strftime(fmt)
    def bars(rows, val, fmt, sub):
        mx = max((val(r) for r in rows), default=1) or 1
        out = []
        for r in rows:
            v = val(r)
            out.append(f'<div class="bar-row"><div class="bar-label" title="{e(r[0])}">{e(r[0])}</div>'
                       f'<div class="bar-track"><div class="bar" style="width:{max(1, 100 * v / mx):.1f}%"></div></div>'
                       f'<div class="bar-val">{fmt(v)}<span>{sub(r)}</span></div></div>')
        return "\n".join(out)
    nS = t["samples"]
    cpu_bars = bars(top_cpu, lambda r: r[1] / nS, lambda v: nf(v) + " %", lambda r: f"pic {nf(r[2], 0)} %")
    mem_bars = bars(top_mem, lambda r: gb(r[3] / nS), lambda v: nf(v, 2) + " Go", lambda r: f"pic {nf(gb(r[4]), 2)} Go")
    peak_html = "".join(
        f"<tr><td>{when(ts)}</td><td class=num>{nf(l, 1)}</td><td class=num>{nf(cpu, 0)} %</td>"
        f"<td>{', '.join(f'{e(n)} <span class=dim>{nf(c, 0)} %</span>' for n, c in procs)}</td></tr>"
        for ts, l, cpu, procs in peaks)
    def delta(d):
        if d is None:
            return '<span class="dim">nouveau</span>'
        if abs(d) < 50 * 1024:
            return '<span class="dim">=</span>'
        return f'<span class="{"up" if d > 0 else "down"}">{"+" if d > 0 else "−"}{fmt_size(abs(d))}</span>'
    dir_html = "".join(f"<tr><td class=path title='{e(p)}'>{e(short_path(p))}</td><td class=num>{fmt_size(kb)}</td>"
                       f"<td class=num>{delta(d)}</td></tr>" for p, kb, d in dirs)
    dir_note = (f"Scan du {day}" + (f", comparé au {prev_day}" if prev_day else "") + ".") if day else \
        "Pas encore de scan des dossiers : il tourne une fois par jour (ou <code>sysstats du</code>)."
    sat = t["load_max"] / t["ncpu"]
    disk_pct = 100 * t["disk_used"] / t["disk_total"]
    return f"""<!doctype html><html lang="fr"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1"><title>Charge machine — {e(title)}</title>
<style>
/* Catppuccin : Latte (clair) / Macchiato (sombre) */
:root{{--page:#e6e9ef;--surface:#eff1f5;--ink:#4c4f69;--ink2:#5c5f77;--muted:#6c6f85;--grid:#ccd0da;--axis:#bcc0cc;
--s1:#1e66f5;--s2:#fe640b;--s3:#8839ef;--band:#40a02b33;--up:#d20f39;--down:#40a02b;--warn:#df8e1d;--border:#ccd0da;--on-s1:#eff1f5;color-scheme:light}}
@media (prefers-color-scheme:dark){{:root{{--page:#1e2030;--surface:#24273a;--ink:#cad3f5;--ink2:#b8c0e0;--muted:#a5adcb;
--grid:#363a4f;--axis:#494d64;--s1:#8aadf4;--s2:#f5a97f;--s3:#c6a0f6;--band:#a6da9533;--up:#ed8796;--down:#a6da95;--warn:#eed49f;--border:#363a4f;--on-s1:#181926;color-scheme:dark}}}}
*{{box-sizing:border-box}}body{{margin:0;background:var(--page);color:var(--ink);font:14px/1.45 -apple-system,BlinkMacSystemFont,"Inter",sans-serif;font-variant-numeric:tabular-nums}}
main{{max-width:1180px;margin:0 auto;padding:24px 16px 48px}}h1{{font-size:22px;margin:0 0 4px}}h2{{font-size:15px;margin:0 0 12px}}
.sub{{color:var(--ink2);margin:0 0 20px}}.dim{{color:var(--muted)}}
