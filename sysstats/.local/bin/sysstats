</script>
<script>const EX={json.dumps(explorer, separators=(",", ":"))};</script>
<script>{EXPLORER_JS}</script>
</body></html>"""


def report(args):
    now = time.time()
    if args.date:
        d = dt.date.fromisoformat(args.date)
        start = int(time.mktime(d.timetuple()))
        end = start + 86400
        title, name = d.strftime("%A %d/%m/%Y"), f"{d.isoformat()}.html"
    else:
        hours = args.days * 24 if args.days else (args.hours or 24)
        start, end = int(now - hours * 3600), int(now) + 1
        title = f"{args.days} derniers jours" if args.days else f"{hours} dernières heures"
        name = f"demande-{dt.datetime.now().strftime('%Y-%m-%d_%H%M')}.html"
    path = build_report(start, end, title, os.path.join(REPORTS, name))
    record("report", path is not None, path or "aucun échantillon")
    if not path:
        print("Aucun échantillon sur cette période (la collecte tourne-t-elle ? `sysstats status`).", file=sys.stderr)
        return 1
    print(path)
    if not args.no_open:
        subprocess.run(["open", path])
    return 0


def daily():
    du_scan()
    d = (dt.datetime.now() - dt.timedelta(hours=6)).date()  # lancé après minuit au réveil → la veille
    start = int(time.mktime(d.timetuple()))
    path = build_report(start, start + 86400, d.strftime("%A %d/%m/%Y"), os.path.join(REPORTS, f"{d.isoformat()}.html"))
    if path:
        print(path)
    return path


def record(job, ok, detail=""):
    try:
        c = db()
        with c:
            c.execute("INSERT OR REPLACE INTO runs VALUES(?,?,?,?)", (job, int(time.time()), int(bool(ok)), detail[:300]))
        c.close()
    except Exception:
        pass


# ---------------------------------------------------------------- launchd

LABELS = {"collect": "local.sysstats.collect", "daily": "local.sysstats.daily"}
AGENTS = os.path.join(HOME, "Library", "LaunchAgents")
SCHEDULES = {
    "collect": "<key>StartInterval</key><integer>300</integer>\n  <key>RunAtLoad</key><true/>",
    "daily": "<key>StartCalendarInterval</key><dict><key>Hour</key><integer>23</integer>"
             "<key>Minute</key><integer>55</integer></dict>",
}


def plist(job):
    exe = os.path.join(HOME, ".local", "bin", "sysstats")
    log = os.path.join(BASE, f"{job}.log")
    return f"""<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>{LABELS[job]}</string>
  <key>ProgramArguments</key><array><string>/usr/bin/python3</string><string>{exe}</string><string>{job}</string></array>
  {SCHEDULES[job]}
  <key>Nice</key><integer>10</integer>
  <key>LowPriorityIO</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>{log}</string>
  <key>StandardErrorPath</key><string>{log}</string>
</dict></plist>
"""


def install():
    if sys.platform != "darwin":
        print("sysstats install : macOS uniquement (launchd).", file=sys.stderr)
        return 1
    os.makedirs(AGENTS, exist_ok=True)
    os.makedirs(BASE, exist_ok=True)
    domain = f"gui/{os.getuid()}"
    for job, label in LABELS.items():
        path = os.path.join(AGENTS, f"{label}.plist")
        subprocess.run(["launchctl", "bootout", f"{domain}/{label}"], capture_output=True)
        with open(path, "w") as f:
            f.write(plist(job))
        r = subprocess.run(["launchctl", "bootstrap", domain, path], capture_output=True, text=True)
        print(f"{'✓' if r.returncode == 0 else '✗'} {label}  {r.stderr.strip()}")
    db().close()
    return 0


def uninstall():
    domain = f"gui/{os.getuid()}"
    for label in LABELS.values():
        subprocess.run(["launchctl", "bootout", f"{domain}/{label}"], capture_output=True)
        path = os.path.join(AGENTS, f"{label}.plist")
        if os.path.exists(path):
            os.remove(path)
        print(f"✓ {label} retiré")
    print(f"Données conservées dans {BASE}")
    return 0


def launchd_state(label):
    out = sh(["launchctl", "print", f"gui/{os.getuid()}/{label}"], timeout=10)
    if not out:
        return "non chargé"
    m = re.search(r"last exit code = (\S+)", out)
    code = m.group(1) if m else ""
    if not code or code.startswith("("):
        return "chargé, pas encore exécuté"
    return "chargé, OK" if code == "0" else f"chargé, dernier code de sortie {code}"


def status():
    c = db()
    n, first, last = c.execute("SELECT COUNT(*), MIN(ts), MAX(ts) FROM samples").fetchone()
    ndays, last_day = c.execute("SELECT COUNT(DISTINCT day), MAX(day) FROM dirs").fetchone()
    runs = {r[0]: r[1:] for r in c.execute("SELECT job, ts, ok, detail FROM runs")}
    c.close()
    f = lambda ts: dt.datetime.fromtimestamp(ts).strftime("%a %d/%m %H:%M") if ts else "—"
    def ago(ts):
        if not ts:
            return ""
        m = int((time.time() - ts) / 60)
        return f"(il y a {m} min)" if m < 120 else f"(il y a {m // 60} h)" if m < 2880 else f"(il y a {m // 1440} j)"
    print("Derniers runs")
    for job, label in (("collect", "collecte"), ("du", "scan dossiers"), ("daily", "rapport du jour"), ("report", "rapport à la demande")):
        ts, ok, detail = runs.get(job, (None, 1, ""))
        mark = "" if ok else "  ✗ " + detail
        print(f"  {label:<22}{f(ts):<16}{ago(ts)}{mark}")
    print("\nDonnées")
    print(f"  échantillons          {n} (du {f(first)} au {f(last)})")
    print(f"  scans dossiers        {ndays} (dernier : {last_day or '—'})")
    reps = sorted((os.path.join(REPORTS, x) for x in os.listdir(REPORTS)), key=os.path.getmtime) if os.path.isdir(REPORTS) else []
    print(f"  rapports              {len(reps)}" + (f" (dernier : {os.path.basename(reps[-1])})" if reps else ""))
    if sys.platform == "darwin":
        print("\nTâches launchd")
        for job, label in LABELS.items():
            print(f"  {label:<26}{launchd_state(label)}")
    print(f"\nbase : {short_path(DB)}\nrapports : {short_path(REPORTS)}")


def main():
    ap = argparse.ArgumentParser(prog="sysstats", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    for name in ("collect", "du", "daily", "status", "install", "uninstall", "path"):
        sub.add_parser(name)
    r = sub.add_parser("report")
    g = r.add_mutually_exclusive_group()
    g.add_argument("--date"); g.add_argument("--hours", type=int); g.add_argument("--days", type=int)
    r.add_argument("--no-open", action="store_true")
    a = ap.parse_args()
    simple = {"status": status, "install": install, "uninstall": uninstall,
              "path": lambda: print(REPORTS)}
    if a.cmd in simple:
        return simple[a.cmd]() or 0
    if a.cmd == "report":
        return report(a)
    # tâches planifiées : on trace le résultat et les erreurs
    jobs = {"collect": collect, "du": du_scan, "daily": daily}
    try:
        res = jobs[a.cmd]()
        record(a.cmd, True, res or "")
        if a.cmd == "daily":
            record("du", True)
    except Exception as exc:
        record(a.cmd, False, f"{type(exc).__name__}: {exc}")
        raise
    return 0


if __name__ == "__main__":
    sys.exit(main())
