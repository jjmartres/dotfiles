    if(b0!==null&&(!on||j===P.length-1)){{const b1=on?p.t:p.t;s+=`<rect x="${{x(b0)}}" y="${{T}}" width="${{Math.max(2,x(b1)-x(b0))}}" height="${{H-T-B}}" fill="${{css('--band')}}"/>`;b0=null}}}})}}
  if(refLine)s+=`<line x1="${{L}}" x2="${{W-R}}" y1="${{y(refLine)}}" y2="${{y(refLine)}}" stroke="${{css('--warn')}}" stroke-dasharray="4 4"/>`;
  for(const se of series){{const segs=[[]];P.forEach(p=>{{if(p[se.k]==null){{if(segs[segs.length-1].length)segs.push([])}}else segs[segs.length-1].push(p)}});
    for(const g of segs){{if(!g.length)continue;const pts=g.map(p=>`${{x(p.t).toFixed(1)}},${{y(p[se.k]).toFixed(1)}}`).join(' ');
