# Shared provider cache: each provider version is downloaded once and
# symlinked into every .terraform/providers instead of being copied.
plugin_cache_dir = "$HOME/.terraform.d/plugin-cache"

# Use the cache even when a lock file lacks hashes for this platform
# (Terraform >= 1.4 otherwise falls back to a private copy per module).
plugin_cache_may_break_dependency_lock_file = true
